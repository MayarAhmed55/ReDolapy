# Backend TryOn API (place in backend_TryOn-master/backend_TryOn-master/.env)
PORT=5000
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=your_jwt_secret
API_KEY=your_github_pat_for_gpt4o_mini
DASHSCOPE_API_KEY=your_dashscope_key
DASHSCOPE_ENDPOINT=https://your-workspace-endpoint.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Frontend (Vite) — place in project root .env
VITE_API_BASE=/api
VITE_GITHUB_TOKEN=your_github_pat_for_gpt4o_mini
VITE_DASHSCOPE_API_KEY=your_dashscope_key
