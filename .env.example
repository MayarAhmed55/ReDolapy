# Frontend (Vite) — project root .env
VITE_API_BASE=/api

# Production: Vercel rewrites /api/* → Cloud Run backend (see vercel.json).
# Cloud Run env (required — wrong values break Google login & Stripe):
#   CLIENT_URL=https://re-dolapy-gp.vercel.app
#   API_URL=https://re-dolapy-gp.vercel.app          ← NOT the Cloud Run URL
# Google OAuth → Authorized redirect URIs (Google Cloud Console):
#   https://re-dolapy-gp.vercel.app/api/auth/google/callback
#   https://tryon-backend-187701052725.us-central1.run.app/api/auth/google/callback

# Auth / store
VITE_GITHUB_TOKEN=your_github_token

# Recycle image generation (DashScope)
VITE_DASHSCOPE_API_KEY=your-dashscope-workspace-api-key
# Same URL as DASHSCOPE_ENDPOINT in backend_TryOn-master/.env
VITE_DASHSCOPE_ENDPOINT=https://your-workspace-host.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Virtual try-on (sent as request headers)
VITE_KIE_API_KEY=your_kie_api_key
VITE_HF_TOKEN=your_huggingface_token

# Backend TryOn API — backend_TryOn-master/.env
# PORT=5000
# MONGO_URI=mongodb://localhost:27017
# JWT_SECRET=your_jwt_secret
# DASHSCOPE_API_KEY=your-dashscope-workspace-api-key
# DASHSCOPE_ENDPOINT=https://your-workspace-host.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# AVATAR_IMAGE_PROVIDER=dashscope
# KIE_API_key=your_kie_api_key
# HF_TOKEN=your_huggingface_token
